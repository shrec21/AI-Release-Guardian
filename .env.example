# AI Release Guardian — Environment Configuration
#
# Copy this file to .env and fill in your values.
# All variables must be prefixed with GUARDIAN_.
# Unprefixed variables are ignored by the settings loader.
#
# Load order (later sources win):
#   1. Defaults hard-coded in src/config/settings.py
#   2. This .env file
#   3. Actual shell environment variables

# ── LLM Configuration ────────────────────────────────────────────────────────

# Anthropic API key for Claude (required for LLM-powered classification)
GUARDIAN_ANTHROPIC_API_KEY=

# Claude model to use for classification and narrative generation
GUARDIAN_LLM_MODEL=claude-sonnet-4-20250514

# Maximum tokens per LLM response
GUARDIAN_LLM_MAX_TOKENS=4096

# Sampling temperature: 0.0 = deterministic, higher = more creative narratives
GUARDIAN_LLM_TEMPERATURE=0.0

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string for audit logs and LangGraph checkpoints
GUARDIAN_DATABASE_URL=postgresql://guardian:guardian@localhost:5432/guardian

# ── CI/CD Integration ─────────────────────────────────────────────────────────

# Jenkins base URL (e.g. https://jenkins.example.com)
GUARDIAN_JENKINS_URL=

# Jenkins API token for authenticating build/log requests
GUARDIAN_JENKINS_TOKEN=

# GitHub personal access token for writing commit statuses
GUARDIAN_GITHUB_TOKEN=

# GitHub repository in owner/repo format (e.g. acme/backend)
GUARDIAN_GITHUB_REPO=

# ── MCP Server Commands ───────────────────────────────────────────────────────

# Command and args to launch the Jenkins MCP server
GUARDIAN_MCP_JENKINS_COMMAND=node
GUARDIAN_MCP_JENKINS_ARGS=["./mcp-servers/jenkins/dist/index.js"]

# Command and args to launch the test-logs MCP server
GUARDIAN_MCP_TEST_LOGS_COMMAND=node
GUARDIAN_MCP_TEST_LOGS_ARGS=["./mcp-servers/test-logs/dist/index.js"]

# Command and args to launch the perf-baselines MCP server
GUARDIAN_MCP_PERF_BASELINES_COMMAND=python
GUARDIAN_MCP_PERF_BASELINES_ARGS=["./mcp-servers/perf-baselines/server.py"]

# Command and args to launch the deploy-history MCP server
GUARDIAN_MCP_DEPLOY_HISTORY_COMMAND=python
GUARDIAN_MCP_DEPLOY_HISTORY_ARGS=["./mcp-servers/deploy-history/server.py"]

# ── Notifications ─────────────────────────────────────────────────────────────

# Slack incoming webhook URL for release notifications
GUARDIAN_SLACK_WEBHOOK_URL=

# Slack channel to post notifications to
GUARDIAN_SLACK_CHANNEL=#releases

# PagerDuty API key for critical-risk escalations
GUARDIAN_PAGERDUTY_API_KEY=

# PagerDuty service ID to route alerts to
GUARDIAN_PAGERDUTY_SERVICE_ID=

# ── Server ────────────────────────────────────────────────────────────────────

# Host address the FastAPI server binds to
GUARDIAN_HOST=0.0.0.0

# Port the FastAPI server listens on
GUARDIAN_PORT=8000

# Enable FastAPI debug mode (auto-reload, detailed errors)
GUARDIAN_DEBUG=false

# ── Feature Flags ─────────────────────────────────────────────────────────────

# Set to true once GUARDIAN_SLACK_WEBHOOK_URL is configured
GUARDIAN_ENABLE_SLACK_NOTIFICATIONS=false

# Set to true once GUARDIAN_PAGERDUTY_API_KEY is configured
GUARDIAN_ENABLE_PAGERDUTY_ALERTS=false

# Set to true once GUARDIAN_GITHUB_TOKEN is configured
GUARDIAN_ENABLE_GITHUB_STATUSES=false

# Set to false to actually trigger CI/CD pipeline actions (proceed/hold/abort).
# Keep true during development and testing to avoid accidental pipeline triggers.
GUARDIAN_DRY_RUN=true
